#!/bin/sh
# CPython 3.15.2 backend. This is not the native JVM Jython interpreter.
set -eu
if [ -z "${JYTHON_HOME:-}" ]; then
    launcher="$0"
    links=0
    while [ -L "$launcher" ]; do
        links=$((links + 1))
        if [ "$links" -gt 40 ]; then
            printf '%s\n' 'Too many launcher symlinks. Set JYTHON_HOME explicitly.' >&2
            exit 2
        fi
        target="$(readlink "$launcher")"
        case "$target" in
            /*) launcher="$target" ;;
            *) launcher="$(dirname "$launcher")/$target" ;;
        esac
    done
    JYTHON_HOME="$(dirname "$launcher")/.."
fi
if [ -f "$JYTHON_HOME/jython-dev.jar" ]; then
    jar="$JYTHON_HOME/jython-dev.jar"
elif [ -f "$JYTHON_HOME/jython.jar" ]; then
    jar="$JYTHON_HOME/jython.jar"
else
    printf '%s\n' 'Cannot find Jython JAR. Build with ant jar copy-dev or set JYTHON_HOME.' >&2
    exit 2
fi
if [ -n "${JAVA_HOME:-}" ]; then
    java="$JAVA_HOME/bin/java"
else
    java=java
fi
exec "$java" "-Dpython.home=$JYTHON_HOME" -cp "$jar" org.python.util.CPythonLauncher "$@"
